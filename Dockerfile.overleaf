# Overleaf-compatible LaTeX image (official Overleaf compile image)
# -----------------------------------------------------------------------------
# This builds on the SAME TeX Live images that Overleaf runs for its "Sandboxed
# Compiles" (one container per compile), published under quay.io/sharelatex.
# Using it makes local output match Overleaf as closely as possible.
#
# >> CHOOSE THE RIGHT YEAR <<
# The tag must match the TeX Live version of YOUR Overleaf project. Find it in
# Overleaf under:  Menu > Settings > TeX Live version.
# Then set the tag below to that year (e.g. 2023.1, 2024.1, 2025.1).
# Available tags: https://quay.io/repository/sharelatex/texlive-full?tab=tags
#
# Note: this is the FULL TeX Live scheme, so abntex2, fontspec and the
# Portuguese hyphenation patterns are already included (no tlmgr install step).
# The image is public (no docker login needed) but large on first pull.
FROM quay.io/sharelatex/texlive-full:2024.1
